[client]
# 客户端默认字符集
default-character-set = utf8mb4
# 与服务端保持一致的 socket 路径，否则本地命令行无法登录
socket = /tmp/mysql.sock

[mysql]
# 数据库默认字符集
default-character-set = utf8mb4
socket = /tmp/mysql.sock

[mysqld]
# ==========================================
# 1. 基础设置 (Basic Settings)
# ==========================================
# 指定物理安装路径和数据目录（离线安装必须声明）
basedir = /usr/local/mysql
datadir = /usr/local/mysql/data

# 使用 /tmp 目录下的 socket
socket = /tmp/mysql.sock

# 默认端口
port = 3306

# 字符集与排序规则(MySQL 8 推荐规范)
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# 默认时区
default-time-zone = '+08:00'

# ==========================================
# 2. 连接与网络 (Connection & Network)
# ==========================================
# 最大并发连接数
max_connections = 60
# 允许每个用户的最大并发连接数
max_user_connections = 50
# 针对部分异常连接的防误杀宽容度
max_connect_errors = 1000
# 网络传输最大数据包 (避免导入包含大文本的 SQL 报错，如大 JSON、LongText)
max_allowed_packet = 64M

# 自动关闭空闲连接 (默认 8 小时太长，建议设为 10 分钟，防止僵尸连接占满)
wait_timeout = 600
interactive_timeout = 600

# ==========================================
# 3. 核心内存设置 (Memory)
# ==========================================
# 【注意】目前设定为 192M。如果你的物理机内存大于 2G，请务必调大此项！
innodb_buffer_pool_size = 192M

# innodb_buffer_pool_size 必须是这个 Chunk 大小（默认128M）的整数倍
innodb_buffer_pool_chunk_size = 64M

# 缓冲池实例数
innodb_buffer_pool_instances = 1

# 连接级别的内存分配 (每个连接都会独立占用，不要设太大)
sort_buffer_size = 512K
read_buffer_size = 512K
read_rnd_buffer_size = 1M
join_buffer_size = 1M

# ==========================================
# 4. InnoDB 性能与磁盘 I/O (InnoDB & I/O)
# ==========================================
# 独立表空间 (MySQL 8 默认已开启，显式写明好习惯)
innodb_file_per_table = 1

# 事务提交刷新策略 (极其重要：1=最安全，0或2=高性能但可能丢最多1秒数据)
innodb_flush_log_at_trx_commit = 2

# Redo Log 文件大小 (MySQL 8.0.30+ 引入)
innodb_redo_log_capacity = 512M

# 控制 InnoDB 的磁盘刷盘方式
innodb_flush_method = O_DIRECT

# ==========================================
# 5. 日志设置 (Logging)
# ==========================================
# 将日志放到 MySQL 的 data 目录下，避免 /var/log/mysql 目录不存在导致的权限报错
log_error = /usr/local/mysql/data/error.log

# 开启慢查询日志
slow_query_log = 1
slow_query_log_file = /usr/local/mysql/data/slow.log
# 超过多少秒的查询被记录
long_query_time = 2.0
# 记录没有使用索引的查询 (可选，生产环境开了日志可能很大)
log_queries_not_using_indexes = 0

# ==========================================
# 6. 安全与其他 (Security & Misc)
# ==========================================
# 禁用符号链接，防止安全漏洞
symbolic-links = 0
# 禁用 DNS 反向解析 (加快客户端连接速度)
skip-name-resolve