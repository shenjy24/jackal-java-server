# DataNode JVM 内存参数。
APP_IOTDB_JMX_OPTS="-Xms256M -Xmx384M -XX:MaxDirectMemorySize=128M"

# ConfigNode JVM 内存参数。
APP_CONFIGNODE_JMX_OPTS="-Xms128M -Xmx192M -XX:MaxDirectMemorySize=64M"

# docker-compose 使用的容器内存上限与预留内存。
APP_MEMORY_LIMIT=1G
APP_MEMORY_RESERVATION=768M

# 对外暴露给 IoTDB 客户端访问的宿主机监听地址和端口。
IOTDB_BIND_IP=0.0.0.0
IOTDB_RPC_PORT=6667

# DataNode RPC 在容器内的监听地址。
# Docker bridge 网络下保持 0.0.0.0；客户端应连接宿主机 IP:IOTDB_RPC_PORT。
DN_RPC_ADDRESS=0.0.0.0
