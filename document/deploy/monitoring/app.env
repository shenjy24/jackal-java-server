PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

PROMETHEUS_RETENTION_TIME=15d

PROMETHEUS_MEMORY_LIMIT=1G
PROMETHEUS_MEMORY_RESERVATION=512M
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_MEMORY_RESERVATION=256M
NODE_EXPORTER_MEMORY_LIMIT=128M
NODE_EXPORTER_MEMORY_RESERVATION=64M
CADVISOR_MEMORY_LIMIT=512M
CADVISOR_MEMORY_RESERVATION=256M

PROMETHEUS_IMAGE=prom/prometheus:v3.13.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:0.60.3
