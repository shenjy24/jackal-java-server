ENV=prod
BRANCH_NAME=main
# git 仓库目录名（与本 deploy 目录同级）
REPO_NAME=jackal-java-server
# 各可部署模块对外端口（宿主机端口 -> 容器 8080）
SERVICE_CLIENT_PORT=18881
SERVICE_ADMIN_PORT=18882
# 日志根目录（脚本会按模块自动追加子目录，如 ../logs/service-admin）
APP_LOG_DIR=../logs
APP_MEMORY_LIMIT=1G
APP_MEMORY_RESERVATION=512M
# 每个模块保留的历史镜像数量
IMAGE_KEEP_COUNT=3
