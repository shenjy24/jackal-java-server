# up.sh、down.sh 和 rollback.sh 使用的应用部署配置。

# ================= 应用 =================
ENV=prod
SPRING_PROFILES_ACTIVE=prod

# 各可部署模块对外端口（宿主机端口 -> 容器 8080）
SERVICE_CLIENT_PORT=18881
SERVICE_ADMIN_PORT=18882

# 日志根目录（脚本会按模块自动追加子目录，如 ../logs/service-admin）
APP_LOG_DIR=../logs
APP_MEMORY_LIMIT=1G
APP_MEMORY_RESERVATION=512M

# 每个模块保留的历史镜像数量
IMAGE_KEEP_COUNT=3

# APP_IMAGE 由 up.sh 写入 release-state-<module>。
# 只有需要手动启动指定镜像时才需要覆盖。
# APP_IMAGE=service-client:prod-20260608120000

# ================= Jar 构建 =================
# 运行时基础镜像必须已存在于内网服务器。
RUNTIME_IMAGE=eclipse-temurin:21-jre

# 默认将 jar 文件放在当前部署方案目录，也可以执行 up.sh 时直接传入 jar 路径。
JAR_DIR=.

# 可选：固定指定部署 jar；为空时按模块自动查找当前目录下唯一 <module>*.jar。
# JAR_FILE=service-client-1.0.0-SNAPSHOT.jar
