ENV=prod
# 各可部署模块对外端口（宿主机端口 -> 容器 8080）
SERVICE_CLIENT_PORT=18881
SERVICE_ADMIN_PORT=18882
# 日志根目录（脚本会按模块自动追加子目录，如 ../logs/service-admin）
APP_LOG_DIR=../logs
APP_MEMORY_LIMIT=1G
APP_MEMORY_RESERVATION=512M
# 每个模块保留的历史镜像数量
IMAGE_KEEP_COUNT=3
# 运行时基础镜像（需提前 docker load 导入）
RUNTIME_IMAGE=eclipse-temurin:21-jre
# 上传的 jar 所在目录（与脚本同级）
JAR_DIR=.
